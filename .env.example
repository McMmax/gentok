# Copy to .env and fill in

# LLM provider: auto (subscription CLI first, then API key) | cli | api | off
# cli = Claude Code CLI on your Pro/Max SUBSCRIPTION (no API credits needed).
#       Install: npm install -g @anthropic-ai/claude-code   then run: claude   (login once)
LLM_PROVIDER=cli

# Only needed for LLM_PROVIDER=api (pay-per-token). Leave empty for subscription use —
# if set, it can also silently switch the CLI itself to API billing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# small | base | medium | large-v3 | off
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# libx264 (default) or h264_nvenc for NVIDIA GPU
VIDEO_ENCODER=libx264

# Max source resolution to download
MAX_HEIGHT=1080

# Caption font (Montserrat/Anton recommended per caption research; must be installed)
CAPTION_FONT=Arial
# Normalize clip audio to TikTok -14 LUFS (1=on)
AUDIO_LOUDNORM=1
